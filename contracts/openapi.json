{
  "openapi": "3.1.0",
  "info": {
    "title": "bff_template",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CheckApisResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "Error"
            ],
            "example": "OK"
          },
          "core_api": {
            "type": "string",
            "enum": [
              "Connected",
              "Unreachable"
            ],
            "example": "Connected"
          }
        },
        "required": [
          "status",
          "core_api"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "example": "Anne"
          },
          "last_name": {
            "type": "string",
            "example": "Le Gall"
          },
          "email": {
            "type": "string",
            "example": "anne.le-gall@mairie360.fr"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "email"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "tags": [
          "Connectivity"
        ],
        "summary": "Checks that the BFF is up",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/check_apis": {
      "get": {
        "security": [],
        "tags": [
          "Connectivity"
        ],
        "summary": "Checks that the upstream APIs are reachable",
        "responses": {
          "200": {
            "description": "Every upstream API is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckApisResponse"
                }
              }
            }
          },
          "502": {
            "description": "At least one upstream API is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckApisResponse"
                }
              }
            }
          }
        }
      }
    },
    "/example/profile": {
      "get": {
        "tags": [
          "Example"
        ],
        "summary": "Profile of the signed-in user (Core API GET /api/v1/user/me/)",
        "responses": {
          "200": {
            "description": "Profile of the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error relayed from Core API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Core API is unavailable or answered an invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Core API is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
