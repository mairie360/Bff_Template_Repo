{
  "openapi": "3.0.0",
  "info": {
    "title": "bff_template",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CheckApiResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "OK"
          },
          "core_api": {
            "type": "string",
            "example": "Connected"
          },
          "calendar_api": {
            "type": "string",
            "example": "Connected"
          }
