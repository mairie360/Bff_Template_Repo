                  "pm.test(\"Error envelope, the token is not echoed\", function () {",
                  "    pm.expect(pm.response.json().error).to.be.an('object');",
                  "    pm.expect(pm.response.text()).to.not.include(pm.environment.get('jwt_forged'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
