{
  "info": {
    "name": "BFF Template integration tests",
    "description": "MAIR-262: working checks (the BFF starts, reaches Core API, serves its contract) and the session resolution of the example route, replayed by newman on docker-compose-integration.yml (./integration_test.sh). The seeded Admin (user 1) and agent (user 2) are impersonated with EdDSA JWTs signed by integration_test.sh with the run's key, like Core signs them (MAIR-680). In a BFF generated from the template, replace the example route with the bootstrap route of the BFF and add one folder per business journey: each journey creates its own data (unique names with {{run_id}}), reads it back, updates it, checks what the fronts rely on and deletes it at the end, so the collection stays replayable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One fresh account per run so the collection is replayable against a persistent database.",
          "if (!pm.environment.get('run_id')) {",
          "    pm.environment.set('run_id', String(Date.now()));",
          "}",
          "if (!pm.environment.get('test_user_email')) {",
          "    pm.environment.set('test_user_email', `newman.${pm.environment.get('run_id')}@mairie360.test`);",
          "}",
          "// MAIR-680: Core alone signs the session JWTs (EdDSA) and the BFF only holds its public key. The",
          "// seeded accounts have no known password and the Postman sandbox cannot sign EdDSA, so their JWTs",
          "// (jwt_admin, jwt_agent, and jwt_forged: Core's kid, another key) are signed by integration_test.sh",
          "// with the run's key and injected by docker-compose-integration.yml. This script only forges",
          "// jwt_hs256: an HS256 token for the Admin signed with a random secret, which must be refused.",
          "const cryptoJs = require('crypto-js');",
          "const b64url = (words) => cryptoJs.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const hsHeader = b64url(cryptoJs.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "const hsPayload = b64url(cryptoJs.enc.Utf8.parse(JSON.stringify({ sub: String(pm.environment.get('admin_user_id')), role: 'admin', exp: Math.floor(Date.now() / 1000) + 3600 })));",
          "pm.environment.set('jwt_hs256', `${hsHeader}.${hsPayload}.${b64url(cryptoJs.HmacSHA256(`${hsHeader}.${hsPayload}`, cryptoJs.lib.WordArray.random(32)))}`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Body says ok\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Upstream APIs are reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/check_apis",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "check_apis"
              ]
            },
            "description": "One `Connected` entry per upstream API the BFF calls: add the others next to core_api."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Every upstream API is connected\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('OK');",
                  "    pm.expect(body.core_api).to.eql('Connected');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "OpenAPI document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi.json"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Document lists the routes\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.openapi).to.be.a('string');",
                  "    pm.expect(body.paths).to.have.property('/health');",
                  "    pm.expect(body.paths).to.have.property('/example/profile');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Unknown route answers a JSON 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/newman/unknown-route",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "newman",
                "unknown-route"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Body is the error envelope\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error, 'error').to.be.an('object');",
                  "    pm.expect(body.error.code).to.be.a('string');",
                  "    pm.expect(body.error.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "description": "The BFF is up, reaches its upstream APIs and serves its contract."
    },
    {
      "name": "Session resolution",
      "item": [
        {
          "name": "Profile without a session is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/example/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "example",
                "profile"
              ]
            },
            "description": "requireBearer answers 401 before any upstream call."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Body is the error envelope\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error, 'error').to.be.an('object');",
                  "    pm.expect(body.error.code).to.be.a('string');",
                  "    pm.expect(body.error.message).to.be.a('string');",
                  "});",
                  "pm.test(\"Answer is not cacheable\", function () {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "MAIR-680 Profile of the seeded administrator (EdDSA, Core's key)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_admin}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/example/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "example",
                "profile"
              ]
            },
            "description": "User 1 is the template admin seeded by liquibase (-Dallow_template_admin=true): its names are not fixed by init-test.sql, only the shape of the answer is checked."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Answer is not cacheable\", function () {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store');",
                  "});",
                  "pm.test(\"Profile comes from Core API and only holds the contract fields\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.first_name).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.last_name).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.email).to.be.a('string').and.not.empty;",
                  "    pm.expect(Object.keys(body).sort()).to.eql(['email', 'first_name', 'last_name']);",
                  "});",
                  "pm.test(\"The token is an EdDSA token under Core's kid (MAIR-680)\", function () {",
                  "    const header = JSON.parse(atob(pm.environment.get('jwt_admin').split('.')[0].replace(/-/g, '+').replace(/_/g, '/')));",
                  "    pm.expect(header.alg).to.eql('EdDSA');",
                  "    pm.expect(header.kid).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "MAIR-680 EdDSA JWT signed with another key under Core's kid is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_forged}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/example/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "example",
                "profile"
              ]
            },
            "description": "User 1 is the template admin seeded by liquibase (-Dallow_template_admin=true): its names are not fixed by init-test.sql, only the shape of the answer is checked."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
